{
  "name": "nbviewer-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side notebook rendering for nbviewer (/v2/)",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "rspack build --mode=production",
    "build:dev": "rspack build --mode=development",
    "watch": "rspack build --mode=development --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'"
  },
  "dependencies": {
    "@jupyterlab/codemirror": "~4.5.11",
    "@jupyterlab/markedparser-extension": "~4.5.11",
    "@jupyterlab/mathjax-extension": "~4.5.11",
    "@jupyterlab/nbformat": "~4.5.11",
    "@jupyterlab/notebook": "~4.5.11",
    "@jupyterlab/rendermime": "~4.5.11",
    "@jupyterlab/rendermime-interfaces": "~3.13.11",
    "@jupyterlab/theme-light-extension": "~4.5.11",
    "@lumino/widgets": "^2.7.5"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "css-loader": "^6.11.0",
    "style-loader": "~3.3.1",
    "typescript": "~5.9.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid"
  }
}
